rules_version = '2';
// FOLk Coffee loyalty card — paste this into Firebase → Firestore → Rules → Publish.
// Customers can only read their own card. Only staff can add stamps or redeem.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // Birthday stored as "MM-DD" (no year).
    function validBirthday(b) { return b is string && b.matches('^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }

    // Staff list: managed by you in the Firebase console only.
    match /staff/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Gift vouchers: ONLY staff can create or use them.
    // Customers can see vouchers linked to their own verified email, and link an
    // unlinked voucher to themselves with its code. Balances only go down; no deletes.
    function myEmail() { return request.auth.token.email.lower(); }
    function verifiedCustomer() { return signedIn() && request.auth.token.email_verified == true; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function validEmail(e) { return e is string && e.size() <= 120 && e.matches('^[^@ ]+@[^@ ]+$'); }

    function validVoucher(d, code) {
      return d.keys().hasOnly(['code', 'amount', 'balance', 'toName', 'fromName', 'message', 'issued', 'expires', 'createdBy', 'createdAt', 'updatedAt', 'toEmail'])
        && (!('toEmail' in d) || validEmail(d.toEmail))
        && d.code == code
        && d.amount is int && d.amount > 0 && d.amount <= 50000
        && d.balance == d.amount
        && d.createdBy == request.auth.uid
        && d.toName is string && d.toName.size() <= 60
        && d.fromName is string && d.fromName.size() <= 60
        && d.message is string && d.message.size() <= 300
        && d.issued is string && d.expires is string && d.expires > d.issued;
    }
    match /vouchers/{code} {
      allow get: if isStaff() || (verifiedCustomer() && resource.data.get('toEmail', '') == myEmail());
      allow list: if isStaff() || (verifiedCustomer() && resource.data.toEmail == myEmail());
      allow create: if isStaff() && code.matches('^FOLK-[A-Z0-9]{4}-[A-Z0-9]{4}$')
        && validVoucher(request.resource.data, code);
      allow update: if (isStaff()
          && onlyChanges(['balance', 'updatedAt'])
          && request.resource.data.balance is int
          && request.resource.data.balance >= 0
          && request.resource.data.balance < resource.data.balance)
        || (isStaff() && onlyChanges(['toEmail', 'updatedAt']) && validEmail(request.resource.data.toEmail))
        || (verifiedCustomer() && !('toEmail' in resource.data)
          && onlyChanges(['toEmail', 'updatedAt']) && request.resource.data.toEmail == myEmail());
      allow delete: if false;

      match /log/{entry} {
        allow read: if isStaff();
        allow create: if isStaff() && request.resource.data.by == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Reports: staff can read every history log (stamps and voucher use) at once.
    match /{path=**}/log/{entry} {
      allow read: if isStaff();
    }

    match /cards/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // A customer can create their own card, starting at zero.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'stamps', 'totalStamps', 'rewardsRedeemed', 'birthday', 'createdAt', 'updatedAt'])
        && request.resource.data.stamps == 0
        && request.resource.data.totalStamps == 0
        && request.resource.data.rewardsRedeemed == 0
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && (!('birthday' in request.resource.data) || validBirthday(request.resource.data.birthday));

      // Only staff change stamps. A customer may change their name,
      // and add their birthday ONCE (only staff can change it after that).
      allow update: if isStaff()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'birthday', 'updatedAt'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['birthday'])
                || (!('birthday' in resource.data) && validBirthday(request.resource.data.birthday))));
      allow delete: if isStaff();

      // Stamp history (who stamped, when).
      match /log/{entry} {
        allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
        allow create: if isStaff();
        allow update, delete: if false;
      }
    }
  }
}
